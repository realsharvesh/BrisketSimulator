theme_override_colors/font_color = Color(0, 1, 1, 1)
theme_override_font_sizes/font_size = 24
text = "                                                                                                                                                                                                                                                 Welcome to Brisket Simulator:
                                                                                                                                                                                                                      Find George, who is somewhere on the ground in the map
                                                                                                                                                                                  Your goal, bounce brisket into George's mouth. All the brisket is raw, but every bounce cooks it. 
                                                                                                                                                                                     But be careful, too many bounces can burn it, and if you feed George a raw or burnt brisket, 
                                                                                                                                                                                                      he won't be happy. If you don't feed him at all, he won't be happy either.
                                                                                                                                                                                           Arrow keys to move and space bar to fire, the brisket launches to your cursor position"

